{
  "collection": "inventory",
  "indexes": [
    {
      "key": {
        "inventory_id": 1
      },
      "unique": true
    },
    {
      "key": {
        "created_by": 1
      },
      "unique": false
    },
    {
      "key": {
        "item_status": 1
      },
      "unique": false
    }
  ],
  "defaults": {
    "quantity_on_hand": "0.00",
    "reorder_level": "0.00",
    "item_status": "Active",
    "created_at": "now"
  },
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "InventoryItem",
      "required": [
        "inventory_id",
        "item_name",
        "category",
        "quantity_on_hand",
        "unit_of_measure",
        "reorder_level",
        "item_status",
        "created_by",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "objectId"
        },
        "inventory_id": {
          "bsonType": "int",
          "minimum": 1,
          "description": "Unique ID for each inventory item"
        },
        "item_name": {
          "bsonType": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Name of the supply item"
        },
        "category": {
          "bsonType": "string",
          "maxLength": 50,
          "description": "Item category, such as Detergent, Conditioner, or Packaging"
        },
        "quantity_on_hand": {
          "bsonType": "decimal",
          "minimum": 0,
          "maximum": 99999999.99,
          "description": "Current stock quantity"
        },
        "unit_of_measure": {
          "bsonType": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "Unit used to track stock, such as liters, kilograms, or pieces"
        },
        "reorder_level": {
          "bsonType": "decimal",
          "minimum": 0,
          "maximum": 99999999.99,
          "description": "Stock threshold for a low-stock alert"
        },
        "item_status": {
          "bsonType": "string",
          "enum": [
            "Active",
            "Inactive"
          ],
          "maxLength": 30,
          "description": "Status: Active or Inactive"
        },
        "created_by": {
          "bsonType": "int",
          "minimum": 1,
          "description": "References users.user_id"
        },
        "created_at": {
          "bsonType": "date",
          "description": "Date and time the inventory was created"
        }
      }
    }
  }
}
